{
  "manifest_version": 3,
  "name": "Focus",
  "version": "1.0.1",
  "description": "Go be useful. X posting only, Instagram blocked, YouTube Studio only.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "webNavigation",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.youtube.com/*",
    "*://*.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Focus",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.youtube.com/*",
        "*://*.instagram.com/*"
      ],
      "js": [
        "content/guard.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked/index.html",
        "blocked/styles.css"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*"
      ]
    },
    {
      "resources": [
        "assets/Geist.woff2"
      ],
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.youtube.com/*",
        "*://*.instagram.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
